{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lunardig/ld-interfaces/schemas/v0/i3-state.schema.json",
  "title": "I-3 State and snapshot format, v0 (LD-PEC-002 §4). Owner: W1. Unstable until M1.",
  "$defs": {
    "Genesis": {
      "type": "object",
      "properties": {
        "schema": { "const": "ld.genesis.v0" },
        "world_id": { "$ref": "common.schema.json#/$defs/Id" },
        "claim_id": { "$ref": "common.schema.json#/$defs/Id" },
        "catalog_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "start_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "deposits": { "type": "array", "items": { "$ref": "#/$defs/Deposit" } },
        "starting_lots": { "type": "array", "items": { "$ref": "#/$defs/Lot" } },
        "environment": {
          "description": "Environment function ids active on this claim.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Id" }
        },
        "trade": {
          "type": "object",
          "description": "Present for a claim in a trade world (LD-PEC-004 A6-1).",
          "properties": {
            "epoch_us": {
              "$ref": "common.schema.json#/$defs/TimeUs",
              "description": "The world's epoch on this claim's time axis; start_us may not be earlier."
            },
            "routes": { "type": "array", "items": { "$ref": "#/$defs/Route" } }
          },
          "required": ["epoch_us", "routes"],
          "additionalProperties": false
        }
      },
      "required": ["schema", "world_id", "claim_id", "catalog_hash", "start_us", "deposits", "starting_lots", "environment"],
      "additionalProperties": false
    },

    "Deposit": {
      "type": "object",
      "properties": {
        "deposit_id": { "$ref": "common.schema.json#/$defs/Id" },
        "remaining": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" },
        "extracted": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" },
        "reservations": {
          "description": "STOCK held for running jobs that feed from this deposit's face port (LD-PEC-005 §3.3). Omitted when empty.",
          "type": "array",
          "items": { "$ref": "#/$defs/Reservation" }
        }
      },
      "required": ["deposit_id", "remaining", "extracted"],
      "additionalProperties": false
    },
    "LotState": {
      "type": "string",
      "enum": ["AVAILABLE", "RESERVED", "WIP", "IN_TRANSIT"]
    },
    "Lot": {
      "type": "object",
      "properties": {
        "lot_id": { "$ref": "common.schema.json#/$defs/Id" },
        "location": { "$ref": "common.schema.json#/$defs/Id" },
        "state": { "$ref": "#/$defs/LotState" },
        "composition": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" },
        "products": {
          "description": "Discrete products in this lot: product id to count.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Id" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/Uint" }
        },
        "wear": {
          "$ref": "common.schema.json#/$defs/Rational",
          "description": "Wear carried by a removed machine's kit (LD-PEC-004 A1-1): the machine's exact wear when removed. Present only on a lot holding one installable product unit; such a lot is never merged."
        },
        "charge": {
          "$ref": "common.schema.json#/$defs/Rational",
          "description": "Charge carried by a removed energy store's kit, exactly, in the catalog's bus energy unit (LD-PEC-005 §8.2). Present only on a lot holding one installable product unit."
        },
        "core": {
          "$ref": "common.schema.json#/$defs/SpeciesAmounts",
          "description": "Core contents carried by a machine kit whose blueprint declares a core (LD-PEC-004 A2-3), such as a reactor's fuel: INSTALL puts them in the new <machine>-core buffer. Present only on a lot holding one installable product unit; omitted when empty. Counts as material in every conservation check."
        }
      },
      "required": ["lot_id", "location", "state", "composition", "products"],
      "additionalProperties": false
    },
    "Reservation": {
      "description": "Quantity of a buffer held for one holder, a job or a shipment. STOCK holds material in the buffer for the holder to draw; SPACE holds free capacity for material the holder will deliver.",
      "type": "object",
      "properties": {
        "job_id": { "$ref": "common.schema.json#/$defs/Id", "description": "Holder: a job id, or a shipment id for an in-transit delivery." },
        "kind": { "type": "string", "enum": ["STOCK", "SPACE"] },
        "species": { "$ref": "common.schema.json#/$defs/Id" },
        "amount": { "$ref": "common.schema.json#/$defs/Uint" }
      },
      "required": ["job_id", "kind", "species", "amount"],
      "additionalProperties": false
    },
    "BufferInstance": {
      "type": "object",
      "properties": {
        "buffer_id": { "$ref": "common.schema.json#/$defs/Id" },
        "template": { "$ref": "common.schema.json#/$defs/Id" },
        "location": { "$ref": "common.schema.json#/$defs/Id" },
        "lot_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "reservations": { "type": "array", "items": { "$ref": "#/$defs/Reservation" } }
      },
      "required": ["buffer_id", "template", "location", "lot_ids", "reservations"],
      "additionalProperties": false
    },
    "MachineMode": {
      "type": "string",
      "enum": ["IDLE", "STARTING", "RUNNING", "STARVED", "BLOCKED", "MAINTENANCE", "FAILED"]
    },
    "MachineInstance": {
      "type": "object",
      "properties": {
        "machine_id": { "$ref": "common.schema.json#/$defs/Id" },
        "blueprint": { "$ref": "common.schema.json#/$defs/Id" },
        "location": { "$ref": "common.schema.json#/$defs/Id" },
        "mode": { "$ref": "#/$defs/MachineMode" },
        "wear_accumulator": { "$ref": "common.schema.json#/$defs/Uint" },
        "rate_setpoint": { "$ref": "common.schema.json#/$defs/Rational", "description": "Requested work-rate ceiling, in work quanta per microsecond." },
        "assigned_job_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } }
      },
      "required": ["machine_id", "blueprint", "location", "mode", "wear_accumulator", "rate_setpoint", "assigned_job_ids"],
      "additionalProperties": false
    },
    "ConnectionInstance": {
      "type": "object",
      "properties": {
        "connection_id": { "$ref": "common.schema.json#/$defs/Id" },
        "template": { "$ref": "common.schema.json#/$defs/Id" },
        "kind": { "type": "string", "enum": ["FEED", "CONVEYOR"] },
        "from_port": { "$ref": "common.schema.json#/$defs/Id" },
        "to_port": { "$ref": "common.schema.json#/$defs/Id" },
        "throughput": { "$ref": "common.schema.json#/$defs/Rational", "description": "Maximum transfer rate, in the template's quantity unit per microsecond." },
        "delay_us": { "$ref": "common.schema.json#/$defs/Uint", "description": "0 for FEED; at least 1 for CONVEYOR." },
        "active": { "type": "boolean" }
      },
      "required": ["connection_id", "template", "kind", "from_port", "to_port", "throughput", "delay_us", "active"],
      "additionalProperties": false
    },
    "EnergyStoreInstance": {
      "type": "object",
      "description": "An installed energy store; store_id is its machine. Charge and capacity are in the bus energy unit; the fraction of charge is the residual (store_id, charge).",
      "properties": {
        "store_id": { "$ref": "common.schema.json#/$defs/Id" },
        "unit": { "$ref": "common.schema.json#/$defs/Id" },
        "charge": { "$ref": "common.schema.json#/$defs/Uint" },
        "capacity": { "$ref": "common.schema.json#/$defs/Uint" },
        "max_charge_rate": { "$ref": "common.schema.json#/$defs/Rational" },
        "max_discharge_rate": { "$ref": "common.schema.json#/$defs/Rational" }
      },
      "required": ["store_id", "unit", "charge", "capacity", "max_charge_rate", "max_discharge_rate"],
      "additionalProperties": false
    },
    "JobStatus": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "STARVED", "BLOCKED", "PAUSED", "COMPLETED", "CANCELLED", "FAILED"]
    },
    "JobInstance": {
      "type": "object",
      "properties": {
        "job_id": { "$ref": "common.schema.json#/$defs/Id" },
        "process": { "$ref": "common.schema.json#/$defs/Id" },
        "process_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "machine_id": { "$ref": "common.schema.json#/$defs/Id" },
        "status": { "$ref": "#/$defs/JobStatus" },
        "started": { "type": "boolean", "description": "True once START is admitted. Only started jobs are dispatched." },
        "reason": { "$ref": "i1-protocol.schema.json#/$defs/Reason", "description": "Why a started job is not running, kept so a restored engine continues exactly (V-09)." },
        "priority": { "$ref": "common.schema.json#/$defs/Int" },
        "target_extent": { "$ref": "common.schema.json#/$defs/Uint" },
        "completed_extent": { "$ref": "common.schema.json#/$defs/Uint" },
        "required_work": { "$ref": "common.schema.json#/$defs/Uint" },
        "completed_work": { "$ref": "common.schema.json#/$defs/Uint" },
        "current_stage": { "$ref": "common.schema.json#/$defs/Id" },
        "held_lot_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "created_at_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "last_advanced_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "rate": { "$ref": "common.schema.json#/$defs/Rational", "description": "A running job's work rate as dispatch allocated it, before load following (LD-PEC-004 A3-5). Present exactly when the job is RUNNING." }
      },
      "required": ["job_id", "process", "process_hash", "machine_id", "status", "started", "priority", "target_extent", "completed_extent", "required_work", "completed_work", "current_stage", "held_lot_ids", "created_at_us", "last_advanced_us"],
      "additionalProperties": false
    },
    "InTransit": {
      "type": "object",
      "properties": {
        "shipment_id": { "$ref": "common.schema.json#/$defs/Id" },
        "connection_id": { "$ref": "common.schema.json#/$defs/Id" },
        "lot_id": { "$ref": "common.schema.json#/$defs/Id" },
        "depart_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "arrive_us": { "$ref": "common.schema.json#/$defs/TimeUs" }
      },
      "required": ["shipment_id", "connection_id", "lot_id", "depart_us", "arrive_us"],
      "additionalProperties": false
    },
    "SinkRecord": {
      "type": "object",
      "properties": {
        "sink_id": { "$ref": "common.schema.json#/$defs/Id" },
        "kind": { "type": "string", "enum": ["RECOVERABLE", "TERMINAL", "HEAT"] },
        "totals": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" },
        "energy": { "$ref": "common.schema.json#/$defs/Uint", "description": "Cumulative energy for HEAT sinks, in the bus energy unit." }
      },
      "required": ["sink_id", "kind", "totals", "energy"],
      "additionalProperties": false
    },
    "PendingEvent": {
      "type": "object",
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/Id" },
        "time_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "kind": { "$ref": "common.schema.json#/$defs/Id" },
        "subject": { "$ref": "common.schema.json#/$defs/Id" }
      },
      "required": ["event_id", "time_us", "kind", "subject"],
      "additionalProperties": false
    },
    "Residual": {
      "type": "object",
      "properties": {
        "owner": { "$ref": "common.schema.json#/$defs/Id" },
        "accumulator": { "$ref": "common.schema.json#/$defs/Id" },
        "value": { "$ref": "common.schema.json#/$defs/Rational" }
      },
      "required": ["owner", "accumulator", "value"],
      "additionalProperties": false
    },

    "Route": {
      "type": "object",
      "description": "A directed route between two claims of a trade world (LD-PEC-004 A6-1).",
      "properties": {
        "route_id": { "$ref": "common.schema.json#/$defs/Id" },
        "from_claim": { "$ref": "common.schema.json#/$defs/Id" },
        "to_claim": { "$ref": "common.schema.json#/$defs/Id" },
        "transit_us": { "$ref": "common.schema.json#/$defs/PositiveInt" },
        "energy_per_kg": {
          "$ref": "common.schema.json#/$defs/Rational",
          "description": "Trip energy per kilogram of carrier and cargo, in the bus energy unit."
        }
      },
      "required": ["route_id", "from_claim", "to_claim", "transit_us", "energy_per_kg"],
      "additionalProperties": false
    },
    "ManifestLot": {
      "type": "object",
      "description": "One lot in a shipment, by content (A6-5). Optional fields are omitted exactly when the lot omits them.",
      "properties": {
        "products": {
          "description": "Discrete products in this lot: product id to count.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Id" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/Uint" }
        },
        "composition": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" },
        "wear": { "$ref": "common.schema.json#/$defs/Rational" },
        "charge": { "$ref": "common.schema.json#/$defs/Rational" },
        "core": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" }
      },
      "required": ["products"],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "contents": { "$ref": "common.schema.json#/$defs/SpeciesAmounts" },
        "lots": { "type": "array", "items": { "$ref": "#/$defs/ManifestLot" } }
      },
      "required": ["contents", "lots"],
      "additionalProperties": false
    },
    "CarrierRecord": {
      "type": "object",
      "description": "The carrier of a shipment: its product, its charge after the trip, and its wear if any.",
      "properties": {
        "product": { "$ref": "common.schema.json#/$defs/Id" },
        "charge": { "$ref": "common.schema.json#/$defs/Rational" },
        "wear": { "$ref": "common.schema.json#/$defs/Rational" }
      },
      "required": ["product", "charge"],
      "additionalProperties": false
    },
    "Certificate": {
      "type": "object",
      "description": "What an export proves about itself (LD-PEC-004 A6-5). Its hash, H(\"ld.trade.certificate.v0\", certificate), is the import identity.",
      "properties": {
        "schema": { "const": "ld.trade.certificate.v0" },
        "world": { "$ref": "common.schema.json#/$defs/Id" },
        "epoch_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "origin_claim": { "$ref": "common.schema.json#/$defs/Id" },
        "catalog_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "export_id": { "$ref": "common.schema.json#/$defs/Id" },
        "n": { "$ref": "common.schema.json#/$defs/PositiveInt" },
        "spend_id": { "$ref": "common.schema.json#/$defs/Hash" },
        "peer_claim": { "$ref": "common.schema.json#/$defs/Id" },
        "route_id": { "$ref": "common.schema.json#/$defs/Id" },
        "depart_us": { "$ref": "common.schema.json#/$defs/TimeUs", "description": "Below 2^63." },
        "arrive_us": { "$ref": "common.schema.json#/$defs/TimeUs", "description": "Below 2^63." },
        "manifest": { "$ref": "#/$defs/Manifest" },
        "carrier": { "$ref": "#/$defs/CarrierRecord" },
        "prev_state_hash": {
          "$ref": "common.schema.json#/$defs/Hash",
          "description": "The origin's physical state hash just before the export."
        },
        "checkpoint": { "type": "null", "description": "Reserved for a published snapshot hash; null in Amendment 6." }
      },
      "required": ["schema", "world", "epoch_us", "origin_claim", "catalog_hash", "export_id", "n", "spend_id", "peer_claim", "route_id", "depart_us", "arrive_us", "manifest", "carrier", "prev_state_hash", "checkpoint"],
      "additionalProperties": false
    },
    "Shipment": {
      "type": "object",
      "description": "An outbound shipment in transit (A6-7). It holds its manifest and carrier inline; no lot is located at it.",
      "properties": {
        "shipment_id": { "$ref": "common.schema.json#/$defs/Id" },
        "export_id": { "$ref": "common.schema.json#/$defs/Id" },
        "peer_claim": { "$ref": "common.schema.json#/$defs/Id" },
        "route_id": { "$ref": "common.schema.json#/$defs/Id" },
        "depart_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "arrive_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "manifest": { "$ref": "#/$defs/Manifest" },
        "carrier": { "$ref": "#/$defs/CarrierRecord" },
        "certificate_hash": { "$ref": "common.schema.json#/$defs/Hash" }
      },
      "required": ["shipment_id", "export_id", "peer_claim", "route_id", "depart_us", "arrive_us", "manifest", "carrier", "certificate_hash"],
      "additionalProperties": false
    },
    "TradeLedger": {
      "type": "object",
      "description": "Material and stored energy that left or entered the claim by shipment: element amounts in mol, and charge in the bus energy unit.",
      "properties": {
        "elements": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Id" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/Rational" }
        },
        "charge": { "$ref": "common.schema.json#/$defs/Rational" }
      },
      "required": ["elements", "charge"],
      "additionalProperties": false
    },
    "TradeState": {
      "type": "object",
      "description": "A trade world claim's exports and imports (A6-7). epoch_us and routes are copied from genesis, so a restored claim has them.",
      "properties": {
        "epoch_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/Route" }, "description": "The genesis routes, sorted by id." },
        "exports": { "$ref": "common.schema.json#/$defs/Uint" },
        "imports": { "$ref": "common.schema.json#/$defs/Uint" },
        "export_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Id" },
          "description": "Every export_id this claim has exported; sorted."
        },
        "accepted": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Hash" },
          "description": "The certificate hash of every accepted import; sorted."
        },
        "exported": { "$ref": "#/$defs/TradeLedger" },
        "imported": { "$ref": "#/$defs/TradeLedger" }
      },
      "required": ["epoch_us", "routes", "exports", "imports", "export_ids", "accepted", "exported", "imported"],
      "additionalProperties": false
    },
    "PhysicalState": {
      "description": "Canonical state; hashed in domain ld.pec.physical-state.v1. Every array is sorted by its first id field.",
      "type": "object",
      "properties": {
        "schema": { "const": "ld.physical-state.v0" },
        "claim_id": { "$ref": "common.schema.json#/$defs/Id" },
        "time_us": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "catalog_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "environment": {
          "description": "Environment functions in effect on this claim, copied from genesis; sorted.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Id" }
        },
        "deposits": { "type": "array", "items": { "$ref": "#/$defs/Deposit" } },
        "lots": { "type": "array", "items": { "$ref": "#/$defs/Lot" } },
        "buffers": { "type": "array", "items": { "$ref": "#/$defs/BufferInstance" } },
        "machines": { "type": "array", "items": { "$ref": "#/$defs/MachineInstance" } },
        "connections": { "type": "array", "items": { "$ref": "#/$defs/ConnectionInstance" } },
        "energy_stores": { "type": "array", "items": { "$ref": "#/$defs/EnergyStoreInstance" } },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/JobInstance" } },
        "in_transit": { "type": "array", "items": { "$ref": "#/$defs/InTransit" } },
        "sinks": { "type": "array", "items": { "$ref": "#/$defs/SinkRecord" } },
        "pending_events": { "type": "array", "items": { "$ref": "#/$defs/PendingEvent" } },
        "residuals": { "type": "array", "items": { "$ref": "#/$defs/Residual" } },
        "id_counters": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/Id" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/Uint" }
        },
        "shipments": {
          "type": "array",
          "items": { "$ref": "#/$defs/Shipment" },
          "description": "Outbound shipments in transit, sorted by id. Present only in a trade world."
        },
        "trade": { "$ref": "#/$defs/TradeState", "description": "Present only in a trade world." }
      },
      "required": ["schema", "claim_id", "time_us", "catalog_hash", "environment", "deposits", "lots", "buffers", "machines", "connections", "energy_stores", "jobs", "in_transit", "sinks", "pending_events", "residuals", "id_counters"],
      "additionalProperties": false
    },
    "ClaimEnvelope": {
      "type": "object",
      "properties": {
        "state_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "history_head": { "$ref": "common.schema.json#/$defs/Hash" },
        "world_id": { "$ref": "common.schema.json#/$defs/Id" },
        "claim_id": { "$ref": "common.schema.json#/$defs/Id" },
        "genesis_hash": { "$ref": "common.schema.json#/$defs/Hash" }
      },
      "required": ["state_hash", "history_head", "world_id", "claim_id", "genesis_hash"],
      "additionalProperties": false
    },
    "HistoryRecord": {
      "description": "Hashed in domain ld.pec.history.v1 (LD-PEC-001 §9.1, LD-PEC-004 §8). The history root is H(ld.pec.history.v1, {genesis_hash, world, claim}).",
      "type": "object",
      "properties": {
        "prev_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "world": { "$ref": "common.schema.json#/$defs/Id" },
        "claim": { "$ref": "common.schema.json#/$defs/Id" },
        "timestamp": { "$ref": "common.schema.json#/$defs/TimeUs" },
        "inputs_hash": { "$ref": "common.schema.json#/$defs/Hash", "description": "A command record hashes {commands: [{command, admission}]}; an event-time record hashes {commands: [], environment: [{function_id, value}]} (LD-PEC-004 §8)." },
        "transition_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "resulting_state_hash": { "$ref": "common.schema.json#/$defs/Hash", "description": "Present on command records only (LD-PEC-004 A2-2). Event-time records commit their events through transition_hash; a verifier re-executes between command records." }
      },
      "required": ["prev_hash", "world", "claim", "timestamp", "inputs_hash", "transition_hash"],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "schema": { "const": "ld.snapshot.v0" },
        "state": { "$ref": "#/$defs/PhysicalState" },
        "envelope": { "$ref": "#/$defs/ClaimEnvelope" },
        "catalog_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "engine_version": { "type": "string", "minLength": 1 },
        "snapshot_hash": { "$ref": "common.schema.json#/$defs/Hash", "description": "Domain ld.snapshot.v0, over this object without snapshot_hash." }
      },
      "required": ["schema", "state", "envelope", "catalog_hash", "engine_version", "snapshot_hash"],
      "additionalProperties": false
    }
  }
}
